# ==============================================================================
# e-Mailbox System - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' for local development or AWS deployment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# Option A: Local MongoDB (Default when running directly on your laptop)
MONGO_URI=mongodb://localhost:27017/e_mailbox

# Option B: Docker Compose MongoDB (When running via docker-compose up)
# MONGO_URI=mongodb://mongodb:27017/e_mailbox

# Option C: Cloud MongoDB Atlas (Required for AWS Lambda deployment)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/e_mailbox?retryWrites=true&w=majority


# ------------------------------------------------------------------------------
# 2. File Storage Configuration
# ------------------------------------------------------------------------------
# [Local Development]:
# Folder on your computer's hard drive where uploaded PDFs/images are saved.
# Also contains the 3 sample demo PDF files used to seed the system for grading.
UPLOAD_FOLDER=uploads

# [AWS Cloud Deployment]:
# In AWS, files are saved in an Amazon S3 Document Bucket instead of a local folder.
# The deployment script automatically reads the demo PDFs from 'uploads/' and uploads
# them to S3. You can optionally specify a custom bucket name below:
# S3_BUCKET_NAME=cs361-g3-documents


# ------------------------------------------------------------------------------
# 3. Flask Server Configuration (Optional)
# ------------------------------------------------------------------------------
PORT=5000
FLASK_DEBUG=1


# ------------------------------------------------------------------------------
# 4. AWS Learner Lab Configuration (For Serverless Deployment)
# ------------------------------------------------------------------------------
# Region (AWS Academy / Learner Lab default is us-east-1)
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Temporary credentials from AWS Learner Lab ("AWS Details" -> "Show" under AWS CLI):
# AWS_ACCESS_KEY_ID=ASIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...
